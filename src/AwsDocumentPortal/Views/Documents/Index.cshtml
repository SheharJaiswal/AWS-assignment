@model IReadOnlyCollection<DocumentItem>
@{ViewData["Title"]="Documents";}<div class="d-flex justify-content-between mb-4"><h1>Submitted documents</h1><a class="btn btn-primary" asp-action="Upload">Upload</a></div>@if(TempData["Success"] is string s){<div class="alert alert-success">@s</div>}@if(Model.Count==0){<div class="alert alert-info">No documents uploaded yet.</div>}else{<table class="table table-striped bg-white"><thead><tr><th>File</th><th>Type</th><th>Size</th><th>Uploaded</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>@d.FileName</td><td>@d.DocumentType</td><td>@($"{d.SizeBytes/1024d:0.0} KB")</td><td>@d.UploadedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td></tr>}</tbody></table>}